# Firebase Configuration (Chỉ cần Auth & Firestore - hoàn toàn FREE không cần thẻ ngân hàng)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# (Tùy chọn) Bỏ trống nếu không dùng Firebase Storage
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Cloudinary Configuration (Lưu trữ ảnh miễn phí 25GB, không cần thẻ ngân hàng)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Fanpage / Zalo contact URLs (Tùy chọn)
NEXT_PUBLIC_FACEBOOK_MESSENGER_URL=https://m.me/your-fanpage
NEXT_PUBLIC_ZALO_URL=https://zalo.me/your-phone-number
