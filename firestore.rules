rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Published products are public. Admins can also read drafts.
    match /products/{productId} {
      allow read: if resource.data.get("isPublished", false) == true || isActiveAdmin();
      allow create, update, delete: if isActiveAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin();
    }

    // Each signed-in user can read only their own admin marker.
    // Provision this document manually from Firebase Console.
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}
